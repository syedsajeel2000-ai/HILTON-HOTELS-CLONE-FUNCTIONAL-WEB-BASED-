[TEMPLATE]
# ----------------------------------------------------------------------------
# LOCAL API (Express + SQLite) — used when Supabase vars below are NOT set
# ----------------------------------------------------------------------------
# Port for the Express API / server (defaults to 4000).
# NOTE: the generic PORT variable is intentionally not used, because many
# hosting environments export PORT=0 or other values that would override it.
API_PORT=4000

# Path to the SQLite database file (defaults to data/grandhaven.db).
# The database is created and seeded automatically on first start.
DB_PATH=data/grandhaven.db

# ----------------------------------------------------------------------------
# SUPABASE (production database) — set these to use Supabase instead
# ----------------------------------------------------------------------------
# Find all three in Supabase Dashboard -> Project Settings -> API.
# VITE_* variables are exposed to the browser and are read at build time,
# so set them in Cloudflare Pages -> Settings -> Environment variables too.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The anon / publishable key (safe for the browser).
VITE_SUPABASE_ANON_KEY=

# The service_role key — NEVER expose in the browser. Only used by
# `node scripts/seed-supabase.mjs` to seed the database.
SUPABASE_SERVICE_ROLE_KEY=
